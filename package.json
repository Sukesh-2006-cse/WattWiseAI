    "debug": "^4.4.3",
    "expo": "~57.0.0",
    "expo-font": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "browserslist": "^4.28.8",
    "css-in-js-utils": "^2.0.1",
    "inline-style-prefixer": "^7.0.1",
    "node-releases": "^2.0.18",
    "pngjs": "^7.0.0",
