# ---------------------------------------------------------------------------
# Blynk IoT Cloud Configuration
# Replace YOUR_BLYNK_DEVICE_TOKEN with your actual Blynk auth token
# ---------------------------------------------------------------------------
EXPO_PUBLIC_BLYNK_API_URL=https://blynk.cloud
EXPO_PUBLIC_BLYNK_AUTH_TOKEN=YOUR_BLYNK_DEVICE_TOKEN

# ---------------------------------------------------------------------------
# Authentication
# Sign in / sign up run entirely on-device (AsyncStorage + salted SHA-256),
# so no auth keys or external project setup are required.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# High Load Email Alerts (EmailJS)
# dashboard.emailjs.com -> Email Services, Email Templates, Account -> API Keys
# Also enable: Account -> Security -> "API requests from non-browser applications"
# Leave the placeholders in place to run the app with email alerts disabled.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_EMAILJS_SERVICE_ID=YOUR_EMAILJS_SERVICE_ID
EXPO_PUBLIC_EMAILJS_TEMPLATE_ID=YOUR_EMAILJS_TEMPLATE_ID
EXPO_PUBLIC_EMAILJS_PUBLIC_KEY=YOUR_EMAILJS_PUBLIC_KEY
