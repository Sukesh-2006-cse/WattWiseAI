# Blynk IoT Cloud Configuration
EXPO_PUBLIC_BLYNK_API_URL=https://blynk.cloud
EXPO_PUBLIC_BLYNK_AUTH_TOKEN=YOUR_BLYNK_DEVICE_TOKEN

# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.lg2htpb.mongodb.net/wattwise?retryWrites=true&w=majority

# Backend API Configuration
EXPO_PUBLIC_BACKEND_URL=http://localhost:5000
PORT=5000

# InfluxDB Time-Series Database Configuration (100% Free Cloud or Local)
# INFLUX_URL=https://us-east-1-1.aws.cloud2.influxdata.com   # Or http://localhost:8086 for local
# INFLUX_TOKEN=your_influxdb_api_token
# INFLUX_ORG=your_influx_org_name_or_email
# INFLUX_BUCKET=wattwise_telemetry
